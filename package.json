{
  "name": "pocketweb",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host --https",
    "wrangler-dev": "npx wrangler@latest dev cloudflare/worker.js --port 3000 --local-protocol=https --local",
    "stripe-listen": "stripe listen --forward-to https://localhost:5173/_/stripe/webhook --skip-verify",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "deploy": "npx wrangler@latest publish"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^1.0.2",
    "@sveltejs/adapter-cloudflare-workers": "^1.0.6",
    "@sveltejs/kit": "^1.3.2",
    "@types/dompurify": "^2.4.0",
    "@types/marked": "^4.0.8",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "@vitejs/plugin-basic-ssl": "^1.0.1",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "prettier": "^2.8.3",
    "prettier-plugin-svelte": "^2.9.0",
    "sass": "^1.57.1",
    "svelte": "^3.55.1",
    "svelte-check": "^3.0.3",
    "tslib": "^2.5.0",
    "typescript": "^4.9.4",
    "vite": "^4.0.4"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "^4.5.9",
    "@fontsource/material-icons": "^4.5.4",
    "@fontsource/material-icons-outlined": "^4.5.4",
    "@magicbell/core": "^5.0.3",
    "awesome-phonenumber": "^4.4.0",
    "dompurify": "^2.4.3",
    "events": "^3.3.0",
    "faunadb": "^4.7.1",
    "javascript-time-ago": "^2.5.9",
    "marked": "^4.2.12",
    "nanoid": "^4.0.0",
    "stripe": "^11.8.0",
    "stytch": "^5.18.1",
    "zod": "^3.20.2"
  }
}
