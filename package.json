{
  "name": "pocketweb",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host --https --port 5174",
    "wrangler-dev": "npx wrangler@latest dev cloudflare/worker.js --port 3000 --local-protocol=https",
    "stripe-listen": "stripe listen --forward-to https://localhost:5173/_/stripe/webhook --skip-verify",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "tail": "npx wrangler@latest tail",
    "deploy": "vite build && npx wrangler@latest publish"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230307.0",
    "@sveltejs/adapter-auto": "^2.0.0",
    "@sveltejs/adapter-cloudflare-workers": "^1.1.0",
    "@sveltejs/kit": "^1.12.0",
    "@types/dompurify": "*",
    "@types/marked": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "@vitejs/plugin-basic-ssl": "*",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-svelte3": "*",
    "prettier": "*",
    "prettier-plugin-svelte": "*",
    "sass": "*",
    "svelte": "^3.57.0",
    "svelte-check": "*",
    "tslib": "*",
    "typescript": "*",
    "vite": "*"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "*",
    "@fontsource/material-icons": "*",
    "@fontsource/material-icons-outlined": "*",
    "@magicbell/core": "^5.0.3",
    "awesome-phonenumber": "*",
    "dompurify": "*",
    "events": "*",
    "faunadb": "^4.8.0",
    "javascript-time-ago": "^2.5.9",
    "marked": "^4.2.12",
    "nanoid": "^4.0.1",
    "stripe": "^11.15.0",
    "stytch": "^6.0.3",
    "zod": "^3.21.4"
  }
}
