{
  "name": "pocketweb",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host --port 5174",
    "wrangler-dev": "npx wrangler@latest dev cloudflare/worker.js --port 3000 --local --local-protocol=https",
    "stripe-listen": "stripe listen --forward-to https://localhost:5174/_/stripe/webhook --skip-verify",
    "build": "vite build",
    "preview": "vite preview",
    ">>>>>>>>>>>>>>>>>>>>>>>>>>>": "",
    "tail-prod": "npx wrangler@latest tail --env production",
    "deploy-prod": "vite build && npx wrangler@latest deploy --env production",
    "<<<<<<<<<<<<<<<<<<<<<<<<<<<": "echo hi",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "tail": "npx wrangler@latest tail",
    "deploy": "vite build && npx wrangler@latest deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230404.0",
    "@sveltejs/adapter-auto": "^2.0.0",
    "@sveltejs/adapter-cloudflare-workers": "^1.1.0",
    "@sveltejs/kit": "^1.15.7",
    "@types/dompurify": "^3.0.1",
    "@types/marked": "^4.0.8",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "eslint": "*",
    "eslint-config-prettier": "*",
    "eslint-plugin-svelte3": "*",
    "prettier": "*",
    "prettier-plugin-svelte": "*",
    "sass": "*",
    "svelte": "^3.58.0",
    "svelte-check": "^3.2.0",
    "tslib": "*",
    "typescript": "*",
    "vite": "^4.2.1"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "^4.5.9",
    "@magicbell/core": "^5.0.3",
    "@material-symbols/font-500": "^0.5.5",
    "@sentry/svelte": "^7.46.0",
    "awesome-phonenumber": "^5.3.0",
    "dompurify": "^3.0.1",
    "events": "^3.3.0",
    "fathom-client": "^3.5.0",
    "faunadb": "^4.8.0",
    "javascript-time-ago": "^2.5.9",
    "marked": "^4.2.12",
    "nanoid": "^4.0.1",
    "stripe": "^11.15.0",
    "stytch": "^6.0.3",
    "toucan-js": "^3.1.0",
    "zod": "^3.21.4"
  }
}
